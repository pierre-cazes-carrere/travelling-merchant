        "        for index in tour_ferme\n",
        "    ]\n",
        "\n",
        "    plt.figure(figsize=(13, 10))\n",
        "\n",
        "    plt.plot(\n",
        "        longitudes,\n",
        "        latitudes,\n",
        "        marker=\"o\",\n",
        "        linestyle=\"-\",\n",
        "        color=\"royalblue\",\n",
